# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
# Absolute origin used for canonical URLs, sitemap, Open Graph and JSON-LD.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://kartheek.engineering

# -----------------------------------------------------------------------------
# Contact / project inquiry delivery
# -----------------------------------------------------------------------------
# Where inquiries are delivered. One of:
#   "formsubmit" (default) — FormSubmit.co. No account, no API key, no domain
#                            verification. The address below is the only config.
#                            First submission sends a one-time confirmation
#                            email that must be clicked before delivery starts.
#   "resend"               — Resend. Needs RESEND_API_KEY and a verified domain.
#   "log"                  — Write to the server console only. Makes no network
#                            call. Use for local UI work.
INQUIRY_DELIVERY=formsubmit

# Inbox that receives project inquiries.
INQUIRY_TO_EMAIL=kartheeklenka1234@gmail.com

# Resend API key (server-only). Only used when INQUIRY_DELIVERY=resend.
# Create at https://resend.com. Never expose with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=

# Sender identity for the Resend path only.
INQUIRY_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# -----------------------------------------------------------------------------
# Spam protection
# -----------------------------------------------------------------------------
# Maximum number of accepted submissions per IP per rolling window.
INQUIRY_RATE_LIMIT_MAX=5
# Rolling window in milliseconds.
INQUIRY_RATE_LIMIT_WINDOW_MS=600000

# -----------------------------------------------------------------------------
# Discovery call booking (Calendly / Cal.com)
# -----------------------------------------------------------------------------
# Leave empty to hide the booking button. When set, the "Book a discovery call"
# CTA links directly to your scheduler.
NEXT_PUBLIC_CALENDLY_URL=
# Fallback used when NEXT_PUBLIC_CALENDLY_URL is not set.
NEXT_PUBLIC_CAL_URL=

# -----------------------------------------------------------------------------
# Analytics (optional, privacy-conscious, no cookies)
# -----------------------------------------------------------------------------
# "none" (default) | "vercel" | "plausible"
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
